{
  "name": "conference-os",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:local": "tsx scripts/local-db.ts",
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "RUN_INTEGRATION=true node --import tsx --test tests/integration.test.ts",
    "start:hosted": "prisma migrate deploy && tsx prisma/seed.ts && next start --hostname 0.0.0.0 --port ${PORT:-3000}"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.28.0",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.9.38",
    "next": "^15.5.7",
    "pdfkit": "^0.20.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.13.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "embedded-postgres": "^18.1.0-beta.16",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
