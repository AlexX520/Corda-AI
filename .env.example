# Docker PostgreSQL (docker compose up -d), or npm run db:local
DATABASE_URL="postgresql://conference:conference@127.0.0.1:54329/conferenceos?schema=public"
# Synthetic role switcher is available only when true. No production identity provider is configured.
DEMO_MODE="true"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
# Leave empty to use the deterministic parser. Optional OpenAI-compatible endpoint.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4.1-mini"
# Outlook (Microsoft Graph). Leave empty to run with simulated mail. See README "Connect Outlook".
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
# consumers = personal Outlook.com accounts; use your tenant id for Microsoft 365
MS_TENANT="consumers"
