generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id
  name String
  email String @unique
  role String
}
model Conference {
  id String @id
  name String
  location String
  timezone String
  startDate String
  endDate String
  slotMinutes Int @default(30)
  roomBufferMinutes Int @default(0)
  preferenceDeadline DateTime?
  preferenceWeight Int @default(100)
  workloadWeight Int @default(12)
  backToBackWeight Int @default(5)
}
model Issuer {
  id String @id
  name String
  sector String
  color String
  contactEmail String
  ownerId String?
}
model Investor {
  id String @id
  name String
  contactEmail String
}
model Email {
  id String @id @default(cuid())
  messageId String @unique
  threadId String
  sender String
  to String[]
  cc String[]
  subject String
  body String
  newContent String
  receivedAt DateTime @default(now())
  conferenceId String?
  issuerId String?
  investorId String?
  category String
  status String @default("Pending review")
  source String @default("manual")
  graphId String?
  proposal Proposal?
}
model Proposal {
  id String @id @default(cuid())
  emailId String @unique
  email Email @relation(fields:[emailId], references:[id])
  extraction Json
  status String @default("Pending")
  reviewerId String?
  reviewNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Availability {
  id String @id @default(cuid())
  conferenceId String
  issuerId String
  start DateTime
  end DateTime
  kind String @default("Available")
  sourceEmailId String?
  approvedBy String
  updatedAt DateTime @updatedAt
  @@index([conferenceId, issuerId])
}
model MeetingRequest {
  id String @id @default(cuid())
  conferenceId String
  issuerId String
  investorId String
  salespersonId String
  bankerId String?
  start DateTime
  end DateTime
  duration Int @default(30)
  alternativeDates String[]
  notes String @default("")
  priority String @default("Normal")
  status String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meeting Meeting?
}
model Meeting {
  id String @id @default(cuid())
  requestId String? @unique
  request MeetingRequest? @relation(fields:[requestId], references:[id])
  conferenceId String
  issuerId String
  investorId String
  start DateTime
  end DateTime
  status String @default("Confirmed")
  location String @default("")
  bankerIds String[]
  approvedRecipients String[]
  sourceEmailId String?
  approvedBy String
  expectedAttendees Int @default(4)
  requiresCube Boolean @default(true)
  updatedAt DateTime @updatedAt
  @@index([conferenceId, issuerId])
}
model Action {
  id String @id @default(cuid())
  type String
  title String
  conferenceId String?
  issuerId String?
  investorId String?
  emailId String?
  requestId String?
  assignedTo String?
  priority String @default("Normal")
  status String @default("Open")
  recommendation String
  createdAt DateTime @default(now())
}
model Draft {
  id String @id @default(cuid())
  meetingId String?
  requestId String?
  emailId String?
  createdBy String
  sender String
  to String[]
  cc String[]
  historicalParticipants String[]
  subject String
  body String
  status String @default("Draft")
  approvedBy String?
  simulatedSentAt DateTime?
  deliveryMode String?
  deliveryReceipt String?
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  entityType String
  entityId String
  before Json?
  after Json?
  createdAt DateTime @default(now())
}

model BankerPreference {
  id String @id @default(cuid())
  conferenceId String
  bankerId String
  issuerId String
  meetingId String?
  preferenceLevel String @default("No Preference")
  preferenceWeight Int @default(0)
  isMandatory Boolean @default(false)
  submissionStatus String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([conferenceId, bankerId])
  @@index([meetingId])
}

model BankerAvailability {
  id String @id @default(cuid())
  conferenceId String
  bankerId String
  start DateTime
  end DateTime
  status String @default("Available")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([conferenceId, bankerId])
}

model IssuerCoverageAuthorization {
  id String @id @default(cuid())
  conferenceId String
  bankerId String
  issuerId String
  qualification String @default("Support")
  isActive Boolean @default(true)
  @@unique([conferenceId, bankerId, issuerId])
}

model MeetingCoverageRequirement {
  id String @id @default(cuid())
  meetingId String @unique
  requiredBankerCount Int @default(2)
  requiredPrimaryCount Int @default(1)
  updatedAt DateTime @updatedAt
}

model MeetingCoverageAssignment {
  id String @id @default(cuid())
  meetingId String
  bankerId String
  coverageRole String @default("Support")
  assignmentStatus String @default("Approved")
  isLocked Boolean @default(false)
  assignedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([meetingId, bankerId])
  @@index([bankerId])
}

model MeetingCube {
  id String @id @default(cuid())
  conferenceId String
  name String
  capacity Int
  location String
  status String @default("Active")
  restrictions String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([conferenceId, name])
}

model CubeAvailability {
  id String @id @default(cuid())
  cubeId String
  start DateTime
  end DateTime
  status String @default("Available")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([cubeId])
}

model MeetingCubeAssignment {
  id String @id @default(cuid())
  meetingId String @unique
  cubeId String
  assignmentStatus String @default("Approved")
  isLocked Boolean @default(false)
  assignedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([cubeId])
}

model AllocationRun {
  id String @id @default(cuid())
  conferenceId String
  algorithmVersion String
  runTimestamp DateTime @default(now())
  runStatus String @default("Proposed")
  objectiveScore Float @default(0)
  createdBy String
  approvedBy String?
  approvedAt DateTime?
  summary Json
  @@index([conferenceId, runTimestamp])
}

model AllocationProposal {
  id String @id @default(cuid())
  allocationRunId String
  meetingId String
  proposedBankerIds String[]
  proposedCubeId String?
  validationStatus String
  preferenceScore Float @default(0)
  explanation String
  manualOverride Boolean @default(false)
  updatedAt DateTime @updatedAt
  @@unique([allocationRunId, meetingId])
  @@index([meetingId])
}

model OutlookAccount {
  id String @id @default(cuid())
  userId String @unique
  email String
  displayName String @default("")
  refreshToken String
  deltaLink String?
  lastSyncAt DateTime?
  lastSyncCount Int @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
