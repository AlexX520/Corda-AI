generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id
  name String
  email String @unique
  role String
  /// Bumped on sign-out so every earlier session token stops working.
  sessionVersion Int @default(0)
  /// Start of the previous visit, for "What changed since you were last here".
  lastSeenAt DateTime?
}
model Conference {
  id String @id
  name String
  location String
  timezone String
  startDate String
  endDate String
  slotMinutes Int @default(30)
  roomBufferMinutes Int @default(0)
  preferenceDeadline DateTime?
  preferenceWeight Int @default(100)
  workloadWeight Int @default(12)
  backToBackWeight Int @default(5)
}
model Issuer {
  id String @id
  name String
  sector String
  color String
  contactEmail String
  ownerId String?
  /// "Hold all changes": set from an escalation; every change for this issuer needs an override reason.
  holdChanges Boolean @default(false)
  holdReason String @default("")
  holdSetBy String?
  holdSetAt DateTime?
}
model Investor {
  id String @id
  name String
  contactEmail String
  /// Salesperson covering this account.
  coverageSalesId String?
}
model Email {
  id String @id @default(cuid())
  messageId String @unique
  threadId String
  sender String
  to String[]
  cc String[]
  subject String
  body String
  newContent String
  receivedAt DateTime @default(now())
  conferenceId String?
  issuerId String?
  investorId String?
  category String
  status String @default("Pending review")
  source String @default("manual")
  graphId String?
  /// internal | verified | unverified — sender domain checked against registered contacts.
  senderStatus String @default("unknown")
  /// Human-readable warnings: links, credential requests, possible MNPI, embedded instructions.
  securityFlags String[] @default([])
  /// How the conference was chosen when the email did not name one.
  contextNote String @default("")
  /// Forwarded mail: who wrote the forwarded message, and who forwarded it.
  originalSender String?
  originalSenderName String?
  forwardedBy String?
  /// Client escalation (complaint, threat, urgent same-day); the email's asks are still extracted.
  escalation Boolean @default(false)
  escalationReasons String[] @default([])
  /// Unverified sender, credential/portal links, data-exfiltration requests or hidden instructions.
  suspicious Boolean @default(false)
  proposals Proposal[]
}
/// One ask inside an email. A reply-all with three changes has three proposals.
model Proposal {
  id String @id @default(cuid())
  emailId String
  email Email @relation(fields:[emailId], references:[id])
  askIndex Int @default(0)
  summary String @default("")
  extraction Json
  status String @default("Pending")
  reviewerId String?
  reviewNote String?
  /// Reviewer re-checked the ask after its meeting changed.
  refreshedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([emailId, askIndex])
}
model Availability {
  id String @id @default(cuid())
  conferenceId String
  issuerId String
  start DateTime
  end DateTime
  kind String @default("Available")
  sourceEmailId String?
  approvedBy String
  updatedAt DateTime @updatedAt
  @@index([conferenceId, issuerId])
}
model MeetingRequest {
  id String @id @default(cuid())
  conferenceId String
  issuerId String
  investorId String
  salespersonId String
  bankerId String?
  start DateTime
  end DateTime
  duration Int @default(30)
  alternativeDates String[]
  notes String @default("")
  priority String @default("Normal")
  status String
  sourceEmailId String?
  attendees Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meeting Meeting?
}
model Meeting {
  id String @id @default(cuid())
  requestId String? @unique
  request MeetingRequest? @relation(fields:[requestId], references:[id])
  conferenceId String
  issuerId String
  investorId String
  start DateTime
  end DateTime
  status String @default("Confirmed")
  location String @default("")
  bankerIds String[]
  approvedRecipients String[]
  sourceEmailId String?
  approvedBy String
  expectedAttendees Int @default(4)
  requiresCube Boolean @default(true)
  /// Optimistic concurrency + "changed since": bumped on every schedule change.
  version Int @default(0)
  changedAt DateTime?
  changedBy String?
  changeSummary String @default("")
  /// An investor threatened to drop it if it moves again.
  protected Boolean @default(false)
  protectedReason String @default("")
  updatedAt DateTime @updatedAt
  @@index([conferenceId, issuerId])
}
model Action {
  id String @id @default(cuid())
  type String
  title String
  conferenceId String?
  issuerId String?
  investorId String?
  emailId String?
  proposalId String?
  requestId String?
  meetingId String?
  assignedTo String?
  /// Also notified (e.g. the issuer owner on an escalation addressed to another banker).
  ccUserIds String[] @default([])
  priority String @default("Normal")
  status String @default("Open")
  recommendation String
  createdAt DateTime @default(now())
  @@index([proposalId])
}
model Draft {
  id String @id @default(cuid())
  meetingId String?
  requestId String?
  emailId String?
  createdBy String
  sender String
  to String[]
  cc String[]
  historicalParticipants String[]
  subject String
  body String
  status String @default("Draft")
  approvedBy String?
  simulatedSentAt DateTime?
  deliveryMode String?
  deliveryReceipt String?
  /// Exact domains allowed without a second confirmation (thread/meeting parties + internal).
  allowedDomains String[] @default([])
  kind String @default("")
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  entityType String
  entityId String
  before Json?
  after Json?
  issuerId String?
  meetingId String?
  emailId String?
  note String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

/// Per-person notices: a change to "your" meeting by someone else, a client's request moving, etc.
model Notification {
  id String @id @default(cuid())
  userId String
  actorId String?
  kind String
  text String
  meetingId String?
  emailId String?
  requestId String?
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

/// When a planner was exported for an audience, to mark "changed since last sent".
model ExportLog {
  id String @id @default(cuid())
  conferenceId String
  scope String
  audienceId String?
  userId String
  /// Meetings in the export, to show "new / changed / removed since last sent" next time.
  meetingIds String[] @default([])
  createdAt DateTime @default(now())
  @@index([conferenceId, scope, audienceId])
}

model BankerPreference {
  id String @id @default(cuid())
  conferenceId String
  bankerId String
  issuerId String
  meetingId String?
  preferenceLevel String @default("No Preference")
  preferenceWeight Int @default(0)
  isMandatory Boolean @default(false)
  submissionStatus String @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([conferenceId, bankerId])
  @@index([meetingId])
}

model BankerAvailability {
  id String @id @default(cuid())
  conferenceId String
  bankerId String
  start DateTime
  end DateTime
  status String @default("Available")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([conferenceId, bankerId])
}

model IssuerCoverageAuthorization {
  id String @id @default(cuid())
  conferenceId String
  bankerId String
  issuerId String
  qualification String @default("Support")
  isActive Boolean @default(true)
  @@unique([conferenceId, bankerId, issuerId])
}

model MeetingCoverageRequirement {
  id String @id @default(cuid())
  meetingId String @unique
  requiredBankerCount Int @default(2)
  requiredPrimaryCount Int @default(1)
  updatedAt DateTime @updatedAt
}

model MeetingCoverageAssignment {
  id String @id @default(cuid())
  meetingId String
  bankerId String
  coverageRole String @default("Support")
  assignmentStatus String @default("Approved")
  isLocked Boolean @default(false)
  assignedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([meetingId, bankerId])
  @@index([bankerId])
}

model MeetingCube {
  id String @id @default(cuid())
  conferenceId String
  name String
  capacity Int
  location String
  status String @default("Active")
  restrictions String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([conferenceId, name])
}

model CubeAvailability {
  id String @id @default(cuid())
  cubeId String
  start DateTime
  end DateTime
  status String @default("Available")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([cubeId])
}

model MeetingCubeAssignment {
  id String @id @default(cuid())
  meetingId String @unique
  cubeId String
  assignmentStatus String @default("Approved")
  isLocked Boolean @default(false)
  assignedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([cubeId])
}

model AllocationRun {
  id String @id @default(cuid())
  conferenceId String
  algorithmVersion String
  runTimestamp DateTime @default(now())
  runStatus String @default("Proposed")
  objectiveScore Float @default(0)
  createdBy String
  approvedBy String?
  approvedAt DateTime?
  summary Json
  @@index([conferenceId, runTimestamp])
}

model AllocationProposal {
  id String @id @default(cuid())
  allocationRunId String
  meetingId String
  proposedBankerIds String[]
  proposedCubeId String?
  validationStatus String
  preferenceScore Float @default(0)
  explanation String
  manualOverride Boolean @default(false)
  updatedAt DateTime @updatedAt
  @@unique([allocationRunId, meetingId])
  @@index([meetingId])
}

model OutlookAccount {
  id String @id @default(cuid())
  userId String @unique
  email String
  displayName String @default("")
  refreshToken String
  deltaLink String?
  lastSyncAt DateTime?
  lastSyncCount Int @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
/// One-time Outlook sign-in handshake (state + PKCE verifier). Kept in the database so it
/// survives serverless hosts where the callback may hit a different instance.
model OutlookAuthState {
  state String @id
  userId String
  verifier String
  appOrigin String
  createdAt DateTime @default(now())
}
